# Copia este ficheiro para .env e preenche os valores localmente.
# Na URI, codifica caracteres especiais do utilizador/password com percent-encoding.
MONGODB_URI=mongodb+srv://<utilizador>:<password>@<cluster>/brainstorming?retryWrites=true&w=majority&authSource=admin
# Usa um segredo aleatorio longo, exclusivo desta aplicacao.
SESSION_SECRET=
LMSTUDIO_API_KEY=
LMSTUDIO_BASE_URL=
